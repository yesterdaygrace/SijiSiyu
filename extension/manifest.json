{
  "manifest_version": 3,
  "name": "Saved — Real-Time Threads Library Sync",
  "version": "1.1.0",
  "description": "Real-time automatic sync of your saved bookmarks from Threads into your local Saved library.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "host_permissions": [
    "https://www.threads.net/*",
    "https://threads.net/*",
    "https://*.threads.net/*",
    "https://www.threads.com/*",
    "https://threads.com/*",
    "https://*.threads.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.threads.net/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://www.threads.com/*",
        "https://threads.com/*",
        "https://*.threads.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Saved — Real-Time Sync"
  }
}
