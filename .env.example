# Create a Meta app with the Threads use case, then fill in its app credentials.
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/auth/threads/callback
THREADS_API_VERSION=v1.0
APP_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Required to encrypt the Threads access token at rest. Generate with:
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
